#!/bin/sh
# Lưới cuối trước khi đẩy lên remote: bắt cả commit đã bỏ qua pre-commit (commit từ GUI, --no-verify).
. "$(dirname "$0")/scan.sh"

remote="$1"
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue            # xoá branch trên remote, không có gì để quét
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes=$remote"      # branch mới: chỉ quét commit remote chưa có
  else
    range="$remote_sha..$local_sha"
  fi
  scan_range "$range" || status=1
done

if [ "$status" -ne 0 ]; then
  echo "❌ Push bị chặn: nghi có secret trong các commit sắp đẩy lên." >&2
  echo "   → Secret đã nằm trong commit: sửa commit đó (hỏi Claude cách làm an toàn), và ĐỔI secret đó ngay." >&2
  exit 1
fi
exit 0
